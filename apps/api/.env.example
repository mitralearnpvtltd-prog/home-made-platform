# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Comma-separated origins allowed to call this API from the browser.
# Matches the existing Vite frontend defaults (5173, and 5174 if 5173 is busy).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Supabase (optional until a project is configured — leave blank locally)
# Ordinary backend client needs SUPABASE_URL + SUPABASE_ANON_KEY (publishable key).
# SUPABASE_SERVICE_ROLE_KEY is required on the API for passenger register/login
# (Admin createUser + confirmed session). It must never be exposed to the frontend.
# Apply these migrations on the Supabase project (non-destructive):
#   20261117000000_profiles_auth_rls.sql
#   20261118000000_backfill_missing_profiles.sql
#   20261119000000_carts.sql   # Meal Bag persistence (apply manually before cart APIs work)
# Never commit real credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cashfree Payment Gateway (SANDBOX only for local development)
# Never commit real credentials. Never put the secret key in Vite/frontend env vars.
# Apply migration 20261128000000_cashfree_payments.sql before using payment APIs.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX
CASHFREE_WEBHOOK_SECRET=
# Frontend origin used for Cashfree return_url redirects after hosted checkout.
CASHFREE_FRONTEND_BASE_URL=http://localhost:5173

# AquaSMS transactional OTP (Nest API only — never put these in Vite/frontend).
# Apply migration 20261129000000_auth_otp_challenges.sql before OTP login/register.
# Use your approved DLT sender name, PEID, template ID, and exact message template.
# Message template must include {otp} exactly as approved by DLT.
AQUASMS_USERNAME=
AQUASMS_API_KEY=
AQUASMS_SENDER_NAME=
AQUASMS_SMS_TYPE=TRANS
AQUASMS_PEID=
AQUASMS_TEMPLATE_ID=
AQUASMS_MESSAGE_TEMPLATE=
# Prefer HTTPS (confirmed available). Override only if AquaSMS instructs otherwise.
AQUASMS_ENDPOINT=https://login.aquasms.com/v2/sendSMS
# GET matches AquaSMS/hspsms-style gateways. Set POST only if AquaSMS requires it.
AQUASMS_HTTP_METHOD=GET
# Optional backend-only diagnostic key for GET /api/v1/sms/diagnostics/*
# Header: x-aahaa-sms-diagnostic-key. Routes return 404 when unset.
AQUASMS_DIAGNOSTIC_KEY=
# Required in production: dedicated pepper for OTP hashes (never reuse the anon key).
# Local fallback uses SUPABASE_SERVICE_ROLE_KEY only when this is empty.
OTP_HASH_PEPPER=

# LOCAL DEVELOPMENT ONLY — ignored when NODE_ENV=production.
# 10-digit Indian mobile of the account that already has the `admin` role.
# When set and NODE_ENV is development|test, login OTP for that admin account is
# fixed to 1234 and AquaSMS is skipped for that phone only. Never commit a real number.
DEV_ADMIN_OTP_PHONE=

# Partner apply migrations (apply in order):
#   20261130000000_partner_applications.sql
#   20261131000000_drop_delivery_partner_identity_columns.sql
#   20261132000000_optional_application_profile_photos.sql

